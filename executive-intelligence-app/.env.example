# Local development only. Copy to `.env` (which is gitignored) and fill in.
# `dev.sh` sources this file automatically.
#
# NONE of these are needed when the app runs inside Databricks Apps — the
# platform injects DATABRICKS_HOST, the service principal credentials, and the
# per-request user token. This file exists purely so the app can run on a laptop.

# You do not need to fill these in by hand. Run ./dev.sh and it will offer the
# workspaces and warehouses you have access to, log you in, and write the
# answers back here.

# Your workspace URL, e.g. https://my-workspace.cloud.databricks.com
DATABRICKS_HOST=

# Which ~/.databrickscfg profile holds the login for that workspace. The host
# alone is ambiguous once two profiles point at the same workspace, so the SDK
# is told explicitly which one to use.
DATABRICKS_CONFIG_PROFILE=

# SQL warehouse the dashboards query. Find it under SQL Warehouses ->
# your warehouse -> Connection details -> HTTP path (the trailing id).
SQL_WAREHOUSE_ID=

# Catalog and schema holding the dashboard contract views (../data/contract.md).
# `python ../data/load.py` creates synthetic ones in a dev workspace.
DATA_CATALOG=
DATA_SCHEMA=

# "false" only when those views read real tables. Otherwise every page is
# badged "Synthetic data". Unset counts as true.
SYNTHETIC_DATA=true

# Workspace group whose members see Settings (each context's agent prompt and
# tools). Locally that is checked against your CLI login's groups.
ADMIN_GROUP=admins

# The Executive Intelligence agent. Point at a local `agentbricks dev` server
# (run it in ../executive-intelligence-agent; it listens on :8000 and takes no
# token), or at the deployed agent app's URL, which is called with your CLI
# login when LOCAL_DEV_AUTH=true.
AGENT_APP_URL=http://localhost:8000

# Which deployment this process is: local | dev | prod. Reported by /api/health
# and used to badge the browser tab; "prod" is left unbadged.
APP_ENVIRONMENT=local

# LOCAL DEV AUTH
# --------------
# Databricks Apps forwards each user's token in the `x-forwarded-access-token`
# header. Nothing forwards that header on your laptop, so local requests have no
# user identity. Setting this to `true` lets the backend fall back to your own
# Databricks CLI login (`databricks auth login`) so you can develop against real
# data as yourself.
#
# This flag is IGNORED when running inside Databricks Apps — the backend detects
# the Apps runtime and refuses to fall back, so a deployment can never
# accidentally serve every user as the service principal.
LOCAL_DEV_AUTH=true

# Identity shown in the UI during local dev, since no IdP headers arrive.
LOCAL_DEV_USER_EMAIL=you@example.com

# Each context's default Genie spaces, as context:tool_name:space_id,
# space-separated. ../data/genie.py prints the entry for each space it creates.
# Without it the local tray has no data tools until you add some in Settings.
# GENIE_BINDINGS="executive:exec_data:<space_id> customer-intelligence:ci_data:<space_id>"

# APP DATABASE (POSTGRES)
# -----------------------
# Settings live in the app's own Postgres. Set nothing here: dev.sh starts a
# bundled Postgres in .pgdata (delete that directory to start over).
#
# In a deployment the bundle's Lakebase project is attached as a `postgres`
# resource, which injects PGHOST, PGPORT, PGUSER, PGDATABASE and PGSSLMODE, and
# the app mints its password from LAKEBASE_ENDPOINT. To use some other Postgres
# locally instead, set PGHOST (and PGPORT, PGUSER, PGPASSWORD, PGDATABASE,
# PGSSLMODE=disable); dev.sh then leaves .pgdata alone.

# The schema this app's tables live in. Not `public` — the app's role does not
# own it on managed Lakebase, so CREATE TABLE there is denied.
# APP_DB_SCHEMA=exec_intel

# THIRD-PARTY API KEYS
# --------------------
# Keys for non-Databricks services go here for local development only. This file
# is gitignored; `.env.example` is not, so never put a real value in the example.
#
# In a deployment these come from a Databricks secret scope attached to the app,
# not from this file — see the `secret` resource in databricks.yml. Calling
# Databricks itself needs no key at all.
# OPENAI_API_KEY=
