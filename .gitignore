# Each project also has its own .gitignore; this covers the root and anything
# workspace-specific that must not be published.

# Secrets and local settings
.env
.env.*
!.env.example
.npmrc
# Per-environment values (workspace profile, catalog, warehouse); only the example is committed.
envs/*.env
!envs/example.env
# Per-deployment branding (customer name, logo, colors); see the app README.
executive-intelligence-app/branding/

# Databricks CLI and Agent Bricks state (bundle state, local traces, run artifacts)
.databricks/
.bundle/
.agentbricks/

# executive-intelligence-agent/app.yaml is regenerated by every `agentbricks deploy` and is
# deliberately tracked: the deploy uploads with `databricks sync`, which skips anything git
# ignores, and the agent app cannot start without it. It holds ids, not credentials.

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Node and build output
node_modules/
dist/
*.tsbuildinfo
package-lock.json
# Lockfiles generated behind a private package mirror pin every package to a
# host nobody outside that network can reach (see the app's .gitignore).
# agentbricks deploy never uploads uv.lock; the Apps build resolves its own.
executive-intelligence-agent/uv.lock

# Logs
*.log

# IDE / OS
.vscode/
.idea/
.DS_Store
